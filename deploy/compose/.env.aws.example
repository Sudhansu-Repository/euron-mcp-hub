# Used by `make up-aws`: the local containers against real AWS resources (from envs/aws-dev
# or your own). Credentials come from your AWS profile (~/.aws is mounted read-only).
AWS_REGION=us-east-1
# The KMS key that encrypts upstream secrets: the key_arn output of the aws-dev environment.
SECRETS_KMS_KEY_ID=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-000000000000
SECRETS_BACKEND=kms
