# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
MCPHUB_SESSION_SECRET=replace-with-output-of-make-env
MCPHUB_API_KEY_PEPPER=replace-with-output-of-make-env
MCPHUB_DEMO_PASSWORD=replace-with-output-of-make-env
MCPHUB_DEMO_TICKETS_TOKEN=replace-with-output-of-make-env
MCPHUB_DEMO_WEATHER_KEY=replace-with-output-of-make-env

# Optional: let the gateway reach MCP servers on private networks (comma separated host
# patterns). The demo servers are always allowed; cloud metadata addresses never are.
# MCPHUB_UPSTREAM_ALLOWED_HOSTS=tickets.internal.example.com,10.0.*

# Optional overrides
# MCPHUB_PRODUCT_NAME=Euron MCPHub
# MCPHUB_LOG_LEVEL=info
# MCPHUB_WEB_PORT=3150
# MCPHUB_API_PORT=8150
# MCPHUB_PG_PORT=5455
# MCPHUB_REDIS_PORT=6415
# MCPHUB_FLOCI_PORT=4615
